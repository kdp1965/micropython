; SPI slave
;
; Transfers to/from the CPU are a byte at a time
;
; Every clock a bit is read and a bit is written
; If no bytes are available to transmit, zeros are written
; 
; Read pins:
; IN:  0: MOSI  
;      1: (input pin) MISO
;      2: SCK
; OUT: 0: MISO  (write SM only)
.program sram_read
top:
    ; We don't wait for CS.  C handles CS
    ;wait 0 pin 0
    set x, 7
read_cmd_loop:
    wait 0 pin 2
    wait 1 pin 2
    in pins, 1
    jmp x--, read_cmd_loop
    wait 0 pin 2
    push

    ; Copy in our 18 bits of base address from 
    ; the C allocation.  The Lower 14 bits
    ; will be shifted in from the ADDRESS 
    ; on the MOSI pin below
    in y, 18

    ; Drop Bit 15 of the MOSI provided address
    wait 1 pin 2

    ; Drop Bit 14 of the MOSI provided address
    wait 0 pin 2
    wait 1 pin 2

    set x, 11
read_addr_loop:
    wait 0 pin 2
    wait 1 pin 2
    in pins, 1
    jmp x--, read_addr_loop
    in null, 2
    set x, 1
read_addr_low_loop:
    wait 0 pin 2
    wait 1 pin 2
    in pins, 1
    jmp x--, read_addr_low_loop
    push
.wrap_target
    set x, 7
read_data_loop:
    wait 0 pin 2
    wait 1 pin 2
    in pins, 1
    jmp x--, read_data_loop
    push

; Crazy plan for unaligned read handling:
; - Data is DMA'd 32-bits at a time
; - On read side send first 30 bits of address (right justified), and then 2 bits end of address
; - Write side program also counts the cycles from the CS going low and then starts branching on the last 2 bits
; - The branch determines how many bits (24, 16, 8 or none) it throws away before outputting to pins

.program sram_write
    ; Don't wait for CS
    ;wait 0 pin 0
    set x, 22
cmd_addr_loop:
    wait 0 pin 2
    wait 1 pin 2
    jmp x--, cmd_addr_loop
PUBLIC addr_loop_end:
    jmp pin, addr_two
    wait 0 pin 2
    wait 1 pin 2
    jmp pin, addr_one
write_loop:
.wrap_target
    wait 0 pin 2
    out pins, 1
    wait 1 pin 2
    jmp write_loop
PUBLIC addr_two:
    wait 0 pin 2
    wait 1 pin 2
    jmp pin, addr_three
    out null, 16
    jmp write_loop
addr_one:
    out null, 8
    jmp write_loop
addr_three:
    out null, 24
    jmp write_loop
PUBLIC fast_read:
    set x, 8
fast_read_loop:
    wait 0 pin 2
    wait 1 pin 2
    jmp x--, fast_read_loop
.wrap

% c-sdk {
void sram_read_program_init(PIO pio, uint sm, uint offset, uint cs_pin, uint mosi_pin, uint sck_pin, uint base) {
    pio_gpio_init(pio, cs_pin);
    pio_gpio_init(pio, mosi_pin);
    pio_gpio_init(pio, sck_pin);
    gpio_set_pulls(mosi_pin, false, false);
    gpio_set_pulls(cs_pin, false, true);
    gpio_set_pulls(sck_pin, false, false);
    
    pio_sm_set_consecutive_pindirs(pio, sm, cs_pin, 2, false);
    pio_sm_set_consecutive_pindirs(pio, sm, sck_pin, 1, false);

    pio_sm_config c = sram_read_program_get_default_config(offset);
    
    // Important: tell PIO which physical pins are used
    sm_config_set_in_pins(&c, mosi_pin);  // CS is the first pin
    sm_config_set_jmp_pin(&c, mosi_pin);  // MOSI pin for wait/jump

    sm_config_set_in_shift(&c, false, true, 32);

    pio_sm_put(pio, sm, base);
    pio_sm_exec(pio, sm, pio_encode_pull(false, true));
    pio_sm_exec(pio, sm, pio_encode_mov(pio_y, pio_osr));

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

void sram_write_program_init(PIO pio, uint sm, uint offset, uint cs_pin, uint mosi_pin, uint miso_pin, uint sck_pin) {
    pio_gpio_init(pio, miso_pin);
    pio_sm_set_consecutive_pindirs(pio, sm, miso_pin, 1, true);

    pio_sm_config c = sram_write_program_get_default_config(offset);
    sm_config_set_in_pins(&c, mosi_pin);     // MOSI input
    sm_config_set_out_pins(&c, miso_pin, 1); // MISO output
    sm_config_set_out_shift(&c, false, true, 32);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    sm_config_set_jmp_pin(&c, mosi_pin);        // CS pin for wait/jump

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}

%}
